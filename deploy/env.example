# Examples only. Do not place credentials in this file or commit local env files.
# Paths may be absolute; relative input paths resolve from the repository root.
PATHSNAP_DATA_DIR="Student folder/student_test"
PATHSNAP_DATASET_ROLE=development
PATHSNAP_MODEL=artifacts/phase_three/model.joblib
PATHSNAP_MODEL_METADATA=artifacts/phase_three/model_metadata.json
PATHSNAP_MATCH_CONFIG=artifacts/phase_three/match_config.json
# Optional separate reference-only root; omitted means .route alongside inputs.
# PATHSNAP_REFERENCE_DIR=/private/pathsnap/references
# Direct same-origin hosting needs no CORS. Exact public origin is safe behind tunnel.
PATHSNAP_CORS_ORIGINS=https://ml.d3va.dev
PATHSNAP_INFERENCE_CONCURRENCY=1
PATHSNAP_GRAPH_CACHE_SIZE=2
PATHSNAP_HOST=127.0.0.1
PATHSNAP_PORT=8000
# PATHSNAP_PYTHON=/absolute/path/to/.venv/bin/python
