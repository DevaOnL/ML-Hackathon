[Unit]
Description=PathSnap same-origin API and website (127.0.0.1:8000)
After=network.target
ConditionPathExists=@AUTH_PATH@
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO_PATH@
ExecStart=/usr/bin/env -i HOME=%h USER=%u LOGNAME=%u PATH=/usr/bin:/bin XDG_RUNTIME_DIR=%t /usr/bin/python3 -I @LAUNCHER_ARG@ api --config-dir @CONFIG_ARG@
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=path-snap-api

[Install]
WantedBy=default.target
